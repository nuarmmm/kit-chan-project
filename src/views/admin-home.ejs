<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กิจกรรมคณะ IT</title>
  <link rel="stylesheet" href="/css/admin-home.css">
  <script src="/js/categories.js" defer></script>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;700&family=Kanit:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Header -->
  <header class="navbar">
  <div class="logo" onclick="location.href='/'">กิจจัง</div>
  <nav>
    <a href="/">หน้าหลัก</a>
    <a href="/notifications">การแจ้งเตือน</a>
  </nav>
  <div class="avatar" id="profileAvatar" aria-label="profile"></div>
</header>
  

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-text">
      <h1>กิจกรรม<br>คณะ IT</h1>
      <p>เว็บไซต์ที่จะพาคุณมารู้จักกับกิจกรรมทั้งหมดของคณะเทคโนโลยีสารสนเทศที่นักศึกษาทุกคนได้เข้าร่วม</p>
      <div class="hero-btns">
        <a href="/login" class="btn primary" id="loginBtn">เข้าสู่ระบบ</a>
        <a href="/register" class="btn secondary" id="registerBtn">ลงทะเบียน</a>
      </div>
    </div>
    <div class="hero-img">
      <img src="https://image-activity.s3.us-east-1.amazonaws.com/icon/image.png" alt="กิจกรรม">
    </div>
  </section>

  <!-- Categories -->
  <section class="categories">
    <a href="#">กิจกรรมทั้งหมด</a>
    <a href="#">วิชาการ</a>
    <a href="#">กีฬาและนันทนาการ</a>
    <a href="#">บำเพ็ญประโยชน์</a>
    <a href="#">ส่งเสริมศิลปวัฒนธรรม</a>
  </section>

  <!-- ช่องค้นหา -->
<div class="search-bar">
  <input id="searchInput" type="text" placeholder="ค้นหากิจกรรม...">
</div>

<!-- สคริปต์ -->
<script src="/js/categories.js" defer></script>
<script src="/js/search.js" defer></script>


  <!-- Activity Section -->
<section class="activities" id="activities-section">
  <h2 id="activities-title">กิจกรรมทั้งหมด</h2>
  <div class="grid" id="activities-grid">
    <% if (user && user.role === 'admin') { %>
      <div class="card add-card" onclick="location.href='/add-event'">
        <div class="plus">+</div>
        <p>เพิ่มกิจกรรม</p>
      </div>
    <% } %>
  </div>
</section>

<script>
  // inject user เพื่อให้ฝั่ง client เช็คได้ (ถ้าจำเป็น)
  window.__USER__ = <%- JSON.stringify(user || null).replace(/</g,'\\u003c') %>;

  // โหลดกิจกรรมจาก API แล้ววางลง grid
  (async function () {
    const grid = document.getElementById('activities-grid');

    async function load(q='') {
      const url = new URL('/api/events', location.origin);
      url.searchParams.set('is_published','true');
      if (q) url.searchParams.set('q', q);

      const res = await fetch(url);
      const payload = await res.json();
      const rows = Array.isArray(payload) ? payload : (payload.items || []);

      const addCard = grid.querySelector('.add-card'); // เก็บ add-card ไว้ (ถ้ามี)
      grid.innerHTML = '';
      if (addCard) grid.appendChild(addCard);

      rows.forEach(ev => {
        const card = document.createElement('div');
        card.className = 'card';
        card.onclick = () => location.href = `/events/${ev.id}`;
        card.innerHTML = `
          <img src="${ev.image_url || 'https://placehold.co/600x350'}" alt="">
          <p>${ev.title || 'Untitled'}</p>
        `;
        grid.appendChild(card);
      });
    }

    load();
  })();

  // avatar → profile
  document.getElementById('profileAvatar')?.addEventListener('click', () => {
    location.href = '/profile';
  });
</script>  
  </script>
</body>
</html>
