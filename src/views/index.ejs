<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>กิจกรรมคณะ IT</title>
  <link rel="stylesheet" href="/css/admin-home.css" />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>
  <header class="navbar">
    <div class="logo">กิจจัง</div>
    <nav>
      <a href="/">หน้าหลัก</a>
      <a href="/notifications">การแจ้งเตือน</a>
    </nav>
    <div class="avatar" id="profileAvatar"></div>
  </header>

  <section class="hero">
    <div class="hero-text">
      <h1>กิจกรรม<br />คณะ IT</h1>
      <p>เว็บไซต์ที่จะพาคุณมารู้จักกับกิจกรรมทั้งหมดของคณะเทคโนโลยีสารสนเทศที่นักศึกษาทุกคนได้เข้าร่วม</p>
      <div class="hero-btns">
        <a href="/login" class="btn primary" id="loginBtn">เข้าสู่ระบบ</a>
        <a href="/register" class="btn secondary" id="registerBtn">ลงทะเบียน</a>
      </div>
    </div>
    <div class="hero-img">
      <img src="https://image-activity.s3.us-east-1.amazonaws.com/icon/image.png" alt="">
    </div>
  </section>

  <section class="categories">
    <a href="#" data-q="">กิจกรรมทั้งหมด</a>
    <a href="#" data-q="วิชาการ">วิชาการ</a>
    <a href="#" data-q="กีฬา">กีฬาและนันทนาการ</a>
    <a href="#" data-q="บำเพ็ญ">บำเพ็ญประโยชน์</a>
    <a href="#" data-q="วัฒนธรรม">ส่งเสริมศิลปวัฒนธรรม</a>
  </section>

  <div class="search-bar">
    <input id="searchInput" type="text" placeholder="ค้นหากิจกรรม...">
    <button id="searchBtn" aria-label="ค้นหา">🔍</button>
  </div>

  <section class="activities">
    <h2 id="activities-title">กิจกรรมทั้งหมด</h2>
    <div class="grid" id="activities-grid">
      <% if (user && user.role==='admin' ) { %>
        <div class="card add-card" onclick="location.href='/add-event'">
          <div class="plus">+</div>
          <p>เพิ่มกิจกรรม</p>
        </div>
        <% } %>
    </div>
  </section>


  <script>
    window.__USER__ = <% - userJSON %>;
  </script>

  <script>
    (async function () {
      const grid = document.getElementById('activities-grid');
      const input = document.getElementById('searchInput');
      const btn = document.getElementById('searchBtn');

      // // ซ่อนปุ่มเข้าสู่ระบบ/สมัคร หากมี token
      // if (localStorage.getItem('token')) {
      //   document.getElementById('loginBtn')?.remove();
      //   document.getElementById('registerBtn')?.remove();
      // }

      async function load(q = '') {
        const url = new URL('/api/events', location.origin);
        url.searchParams.set('is_published', 'true'); // ตรงกับแบ็กเอนด์
        if (q) url.searchParams.set('q', q);

        const res = await fetch(url);
        const payload = await res.json();

        // รองรับทั้งสองรูปแบบ: { items: [...] } หรือ [...]
        const rows = Array.isArray(payload) ? payload : (payload.items || []);

        // เก็บ add-card ของ admin ไว้ถ้ามี
        const addCard = grid.querySelector('.add-card');
        grid.innerHTML = '';
        if (addCard) grid.appendChild(addCard);

        rows.forEach(ev => {
          const card = document.createElement('div');
          card.className = 'card';
          card.onclick = () => location.href = `/events/${ev.id}`;
          card.innerHTML = `
          <img src="${ev.image_url || 'https://placehold.co/600x350'}" alt="">
          <p>${ev.title || 'Untitled'}</p>
        `;
          grid.appendChild(card);
        });
      }

      // ค้นหา
      btn.addEventListener('click', () => load(input.value.trim()));
      input.addEventListener('keyup', e => { if (e.key === 'Enter') load(input.value.trim()); });

      // เริ่มต้น
      load();
    })();
  </script>
</body>

</html>