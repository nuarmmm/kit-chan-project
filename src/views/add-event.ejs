<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>เพิ่มกิจกรรม</title>

  <!-- ฟอนต์ไทยเรียบๆ -->
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/add-event.css"/>
</head>
<body>
  <!-- แถบด้านบน -->
  <header class="topbar">
    <div class="topbar__inner">
      <nav class="topbar__nav">
        <a href="/">หน้าหลัก</a>
      </nav>
      <div class="avatar" aria-label="โปรไฟล์ผู้ใช้"></div>
    </div>
  </header>

  <main class="container">
    <input id="title" name="title" type="text" class="field__input-underline" placeholder="ชื่อกิจกรรม"/>

    <form id="addEventForm" class="card" action="/api/events" method="post" enctype="multipart/form-data">
      <!-- กล่องอัปโหลดรูป -->
      <div class="uploader">
        <input type="file" id="cover" name="cover" class="uploader__input" accept="image/*" hidden>
        <label for="cover" class="uploader__box" id="coverBox">
          <span class="uploader__plus">+</span>
        </label>
      </div>

      <!-- รายละเอียด -->
      <div class="field">
        <label for="desc" class="field__label">รายละเอียดกิจกรรม</label>
        <textarea id="desc" name="description" rows="6" class="field__textarea" placeholder="อธิบายรายละเอียดกิจกรรม..."></textarea>
      </div>

      <!-- สองช่อง: วันที่จัด / วันปิดรับสมัคร -->
      <div class="row">
        <div class="field">
          <label for="eventDate" class="field__label">วันที่จัดกิจกรรม</label>
          <input id="eventDate" name="event_date" type="date" class="field__input-underline">
        </div>

        <div class="field">
          <label for="closeDate" class="field__label">วันปิดรับสมัคร</label>
          <input id="closeDate" name="close_date" type="date" class="field__input-underline">
        </div>
      </div>

      <!-- สถานที่ -->
      <div class="row">
        <div class="field field--grow">
          <label for="location" class="field__label">สถานที่จัดกิจกรรม</label>
          <input id="location" name="location" type="text" class="field__input-underline" placeholder="เช่น ห้องประชุม 403 อาคาร A">
        </div>
      </div>

      <!-- ปุ่ม -->
      <div class="actions">
        <button type="submit" class="btn-primary" id="submitBtn">เพิ่ม</button>
      </div>
      <div id="formMsg"></div>
    </form>
  </main>
    <script>
      // พรีวิวรูปที่เลือก
      const coverInput = document.getElementById('cover');
      const coverBox = document.getElementById('coverBox');
      coverInput.addEventListener('change', () => {
        const file = coverInput.files?.[0];
        if (!file) {
          coverBox.style.backgroundImage = '';
          coverBox.innerHTML = '<span class="uploader__plus">+</span>';
          return;
        }
        const url = URL.createObjectURL(file);
        coverBox.style.backgroundImage = `url("${url}")`;
        coverBox.innerHTML = '';
      });

      // ส่งข้อมูลเป็น JSON ไปยัง /api/events แล้ว redirect ไป /events/:id
      const form = document.getElementById('addEventForm');
      const submitBtn = document.getElementById('submitBtn');
      const formMsg = document.getElementById('formMsg');

      function toISODate(dateStr) {
        if (!dateStr) return null;
        return new Date(`${dateStr}T12:00:00`).toISOString();
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        formMsg.textContent = '';
        formMsg.className = '';
        if (submitBtn) submitBtn.disabled = true;

        try {
          const title = document.getElementById('title').value.trim();
          const description = document.getElementById('desc').value.trim();
          const eventDate = document.getElementById('eventDate').value;   // YYYY-MM-DD
          const closeDate = document.getElementById('closeDate').value;   // YYYY-MM-DD
          const location = document.getElementById('location').value.trim();

          if (!title) throw new Error('กรอกชื่อกิจกรรมก่อน');
          if (!eventDate) throw new Error('กรอกวันที่จัดกิจกรรม');

          // แมปฟิลด์ให้ตรงกับ API ใน /api/events (ดู router.post ใน routes/event.routes.js)
          const payload = {
            title,
            description: description || null,
            start_at: toISODate(eventDate),
            reg_close_at: toISODate(closeDate),
            location: location || null,
            is_published: true,
            image_url: null,
            images: []
          };

          const res = await fetch('/api/events', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.message || `สร้างกิจกรรมไม่สำเร็จ (HTTP ${res.status})`);

          formMsg.textContent = 'สร้างกิจกรรมสำเร็จ!';
          formMsg.className = 'success';

          // เปิดหน้ารายละเอียดกิจกรรม (SSR)
          if (data.id) window.location.href = `/events/${data.id}`;
          else window.location.href = `/`;
        } catch (err) {
          formMsg.textContent = err.message || 'เกิดข้อผิดพลาด กรุณาลองใหม่';
          formMsg.className = 'error';
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    </script>
</body>
</html>
