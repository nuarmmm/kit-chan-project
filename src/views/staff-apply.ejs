<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || 'สมัครสตาฟ' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/staff-apply.css">
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;700&family=Kanit:wght@400;700&display=swap"
        rel="stylesheet">
    <style>
        body,
        .formgrid,
        .navline,
        .ribbon,
        .btn,
        input,
        label,
        .radio,
        .radio-col,
        h1,
        h2,
        h3,
        small {
            font-family: 'Prompt', 'Kanit', sans-serif !important;
        }
    </style>
</head>

<body>
    <div class="navline">
        <div class="navline__inner" style="font-family: 'Prompt', 'Kanit', sans-serif;">
            <div class="links">
                <a href="/" style="font-family: 'Prompt', 'Kanit', sans-serif;">หน้าหลัก</a>
                <a href="#" style="font-family: 'Prompt', 'Kanit', sans-serif;">การแจ้งเตือน</a>
            </div>
            <div class="avatar" id="profileAvatar" aria-label="profile"></div>
        </div>
    </div>

    <!-- เฮดเดอร์กิจกรรม (ได้จาก SSR) -->
    <header class="ribbon">
        <div class="ribbon__inner">
            <h1 id="campTitle">
                <%= event.title %>
            </h1>
            <small id="campSubtitle">
                <%= event.subtitle || event.theme || '' %>
            </small>
        </div>
    </header>

    <!-- เก็บค่าไว้ให้ JS ใช้ยิง API -->
    <main class="page" id="pageRoot" data-event-id="<%= eventId %>" data-api-base="<%= apiBase || '/api' %>">

        <form id="applyForm" class="formgrid" novalidate>
            <div class="field">
                <label for="student_code">รหัสนักศึกษา</label>
                <input id="student_code" name="student_code" type="text">
            </div>
            <div class="field">
                <label for="title">คำนำหน้า</label>
                <input id="title" name="title" type="text">
            </div>

            <div class="field">
                <label for="first_name">ชื่อจริง</label>
                <input id="first_name" name="first_name" type="text" required>
            </div>
            <div class="field">
                <label for="last_name">นามสกุล</label>
                <input id="last_name" name="last_name" type="text" required>
            </div>

            <div class="field">
                <label for="nickname">ชื่อเล่น</label>
                <input id="nickname" name="nickname" type="text">
            </div>
            <div class="field">
                <label for="phone">เบอร์โทรศัพท์</label>
                <input id="phone" name="phone" type="tel">
            </div>

            <div class="field">
                <label for="email">อีเมล</label>
                <input id="email" name="email" type="email" required>
            </div>
            <div></div>

            <div class="field">
                <label>สาขา</label>
                <div class="radio-col">
                    <label class="radio"><input type="radio" name="major" value="IT" required> IT</label>
                    <label class="radio"><input type="radio" name="major" value="DSBA"> DSBA</label>
                    <label class="radio"><input type="radio" name="major" value="BIT"> BIT</label>
                    <label class="radio"><input type="radio" name="major" value="AIT"> AIT</label>
                </div>
            </div>

            <div class="field">
                <label>รุ่น</label>
                <div class="radio-col">
                    <label class="radio"><input type="radio" name="cohort" value="20" required> 20</label>
                    <label class="radio"><input type="radio" name="cohort" value="21"> 21</label>
                    <label class="radio"><input type="radio" name="cohort" value="22"> 22</label>
                    <label class="radio"><input type="radio" name="cohort" value="23"> 23</label>
                </div>
            </div>

            <div class="field">
                <label for="position_applied">ตำแหน่งที่สมัคร</label>
                <input id="position_applied" name="position_applied" type="text">
            </div>
            <div class="field">
                <label for="experience">ประสบการณ์ที่ผ่านมา</label>
                <input id="experience" name="experience" type="text">
            </div>

            <div class="field full">
                <label for="motivation">ทำไมถึงอยากมาทำกิจกรรมนี้</label>
                <input id="motivation" name="motivation" type="text">
            </div>

            <div id="msg" class="full"></div>

            <div class="actions full">
                <button class="btn" type="reset">ล้างข้อมูล</button>
                <button id="submitBtn" class="btn primary" type="submit">ส่งใบสมัคร</button>
            </div>
        </form>
    </main>

    <script>
        const root = document.getElementById('pageRoot');
        const EVENT_ID = Number(root.dataset.eventId);
        const API_BASE = root.dataset.apiBase;

        const form = document.getElementById('applyForm');
        const btn = document.getElementById('submitBtn');
        const msg = document.getElementById('msg');

        // ===== เติมหัวข้อค่ายด้วย API ของกิจกรรม (รองรับกรณีไม่ได้ SSR event) =====
        (async () => {
            try {
                const r = await fetch(`${API_BASE}/events/${EVENT_ID}`);
                if (!r.ok) return;
                const ev = await r.json();
                if (ev?.title) document.getElementById('campTitle').textContent = ev.title;
                if (ev?.subtitle || ev?.theme) document.getElementById('campSubtitle').textContent = ev.subtitle || ev.theme;
                document.title = `สมัครสตาฟ — ${ev?.title || 'กิจกรรม'}`;
            } catch { }
        })();

        function flash(ok, text) {
            msg.className = 'full alert ' + (ok ? 'alert-success' : 'alert-danger');
            msg.textContent = text;
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            msg.className = 'full'; msg.textContent = '';

            const raw = Object.fromEntries(new FormData(form).entries());
            const data = Object.fromEntries(Object.entries(raw).map(([k, v]) => [k, (v?.trim?.() ?? v) || null]));

            if (!data.first_name || !data.last_name || !data.email) return flash(false, 'กรอกชื่อ-นามสกุล-อีเมล');
            if (!data.major || !data.cohort) return flash(false, 'เลือกสาขาและรุ่น');
            if (data.cohort != null) data.cohort = Number(data.cohort);

            const headers = { 'Content-Type': 'application/json' };
            const jwt = localStorage.getItem('jwt');
            if (jwt) headers.Authorization = `Bearer ${jwt}`;

            btn.disabled = true; btn.textContent = 'กำลังส่ง...';
            try {
                const res = await fetch(`${API_BASE}/events/${EVENT_ID}/staff-applications`, {
                    method: 'POST', headers, body: JSON.stringify(data)
                });
                const json = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(json.message || `Error ${res.status}`);
                flash(true, 'ส่งใบสมัครเรียบร้อยแล้ว ✨');
                form.reset();
            } catch (err) {
                flash(false, err.message || 'ส่งไม่สำเร็จ');
            } finally {
                btn.disabled = false; btn.textContent = 'ส่งใบสมัคร';
            }
        });
    </script>
</body>

</html>